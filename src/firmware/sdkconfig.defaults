# The main task only brings the board up and runs light work; everything heavy has a
# thread of its own. Every byte here is taken from the heap TLS needs.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The USB cable is the only console: UART0 is sealed in the case, and its RX pin
# (GPIO44) is the long button.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# esp-idf-hal always compiles the legacy I2C driver next to the new one.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# FatFs silently mangles long names to 8.3 without this.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# No PSRAM, so a TLS handshake has to fit in what the heap has left: buffers sized to
# what is sent, and the configuration and root certificates freed once connected.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# Nothing of ours is in NVS: the PHY recalibrates at every boot instead of caching there.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
