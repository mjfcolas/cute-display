# Room for Rust and for the panel's 12 KB image buffers.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The USB cable is the only console: UART0 is sealed in the case, and its RX pin
# (GPIO44) is the long button.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# esp-idf-hal always compiles the legacy I2C driver next to the new one.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y

# FatFs silently mangles long names to 8.3 without this.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# NVS holds the stock firmware's Wi-Fi credentials and must stay untouched: the PHY
# recalibrates at every boot instead of caching there.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
