.step {
    padding: 1 2;
    height: 1fr;
}

.question {
    margin-bottom: 1;
    text-style: bold;
}

Message {
    height: auto;
    margin: 1 0 0 0;
}

Message.problem {
    color: $error;
}

Message.done {
    color: $success;
}

OptionList, SelectionList {
    height: 1fr;
    min-height: 3;
}
